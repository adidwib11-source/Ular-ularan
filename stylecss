
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px;
    background: radial-gradient(circle at top, #1d3048, #0b1220 70%);
    color: #ffffff;
    font-family: Arial, sans-serif;
}

.game-container {
    width: 100%;
    max-width: 400px;
    text-align: center;
}

h1 {
    margin-bottom: 20px;
    color: #62f58a;
    font-size: 30px;
    text-shadow: 0 0 16px #36d96b40;
}

.score-board {
    display: flex;
    justify-content: space-between;
    margin-bottom: 12px;
    padding: 14px 16px;
    background: #1b293d;
    border: 1px solid #30445d;
    border-radius: 12px;
    font-size: 15px;
}

.score-board strong {
    color: #62f58a;
}

.game-screen {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border: 2px solid #4de77a;
    border-radius: 14px;
    background: #08111e;
    box-shadow: 0 0 24px #36d96b18;
}

canvas {
    display: block;
    width: 100%;
    height: 100%;
}

.game-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 18px;
    padding: 20px;
    background: #08111edb;
}

.game-overlay.hidden {
    display: none;
}

.game-overlay h2 {
    font-size: 24px;
}

#start-button {
    padding: 13px 25px;
    border: none;
    border-radius: 10px;
    background: linear-gradient(135deg, #71ffa0, #36d96b);
    color: #0b1a12;
    font-size: 16px;
    font-weight: bold;
    box-shadow: 0 5px 16px #36d96b30;
    cursor: pointer;
}

#start-button:active {
    transform: scale(0.96);
}

.controller-section {
    margin-top: 24px;
}

.controller-label {
    margin-bottom: 16px;
    color: #8fa6c2;
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 4px;
}

.joystick {
    display: grid;
    grid-template-columns: repeat(3, 68px);
    grid-template-rows: repeat(3, 62px);
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: max-content;
    margin: 0 auto;
    padding: 13px;
    border: 1px solid #344760;
    border-radius: 24px;
    background: linear-gradient(145deg, #202f45, #121e30);
    box-shadow:
        0 12px 25px #00000045,
        inset 0 1px 1px #ffffff0d;
}

.direction {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 68px;
    height: 62px;
    border: 1px solid #526780;
    border-radius: 13px;
    background: linear-gradient(145deg, #354962, #24354b);
    color: #f4f8ff;
    font-size: 23px;
    cursor: pointer;
    touch-action: manipulation;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
    box-shadow:
        0 4px 0 #101a29,
        inset 0 1px 1px #ffffff14;
    transition: background 0.08s, transform 0.08s, box-shadow 0.08s;
}

.direction span {
    display: block;
    line-height: 1;
}

.direction.up {
    grid-column: 2;
    grid-row: 1;
}

.direction.left {
    grid-column: 1;
    grid-row: 2;
}

.direction.right {
    grid-column: 3;
    grid-row: 2;
}

.direction.down {
    grid-column: 2;
    grid-row: 3;
}

.joystick-center {
    grid-column: 2;
    grid-row: 2;
    display: flex;
    justify-content: center;
    align-items: center;
    width: 68px;
    height: 62px;
    border: 1px solid #344860;
    border-radius: 12px;
    background: #172438;
}

.joystick-center div {
    width: 24px;
    height: 24px;
    border: 2px solid #506782;
    border-radius: 50%;
    background: #263950;
    box-shadow: inset 0 2px 4px #00000040;
}

.direction:active {
    transform: translateY(3px);
    border-color: #73ffa0;
    background: linear-gradient(145deg, #48d875, #239b4a);
    color: #07170c;
    box-shadow:
        0 1px 0 #101a29,
        0 0 14px #36d96b45;
}

.direction:focus-visible,
#start-button:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 3px;
}

.hint {
    margin-top: 19px;
    color: #91a4bd;
    font-size: 12px;
    line-height: 1.6;
}

@media (max-width: 380px) {
    body {
        padding: 14px;
    }

    h1 {
        font-size: 26px;
    }

    .joystick {
        grid-template-columns: repeat(3, 62px);
        grid-template-rows: repeat(3, 56px);
        gap: 5px;
        padding: 11px;
    }

    .direction {
        width: 62px;
        height: 56px;
        font-size: 21px;
    }

    .joystick-center {
        width: 62px;
        height: 56px;
    }
}
