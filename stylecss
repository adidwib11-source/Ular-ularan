
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

:root {
    color-scheme: dark;
    --bg: #0b1020;
    --panel: #121b30;
    --line: #263752;
    --green: #5cff9d;
    --muted: #8293ad;
}

body {
    min-height: 100vh;
    min-height: 100dvh;
    padding: 22px;
    background:
        radial-gradient(ellipse at 15% 0%, #17352f 0%, transparent 38%),
        radial-gradient(ellipse at 100% 100%, #17264b 0%, transparent 40%),
        var(--bg);
    color: #f3f7ff;
    font-family: Arial, sans-serif;
}

button {
    font: inherit;
    -webkit-tap-highlight-color: transparent;
}

.game-container {
    width: 100%;
    max-width: 900px;
    margin: 0 auto;
}

.game-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-bottom: 24px;
}

.brand {
    display: flex;
    align-items: center;
    gap: 12px;
}

.brand-icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid #3b7959;
    border-radius: 15px;
    background: #173a30;
    font-size: 27px;
    box-shadow: 0 0 24px #5cff9d14;
}

.brand h1 {
    color: var(--green);
    font-size: 25px;
    letter-spacing: 0.5px;
}

.brand p {
    margin-top: 5px;
    color: var(--muted);
    font-size: 9px;
    letter-spacing: 2px;
}

.score-board {
    display: flex;
    gap: 10px;
}

.score-card {
    min-width: 82px;
    padding: 10px 14px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: #141e32e8;
}

.score-card span {
    display: block;
    margin-bottom: 5px;
    color: var(--muted);
    font-size: 10px;
    letter-spacing: 1.5px;
}

.score-card strong {
    color: var(--green);
    font-size: 22px;
}

.game-layout {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 26px;
}

.game-panel {
    width: 100%;
    max-width: 480px;
    min-width: 0;
    padding: 12px;
    border: 1px solid var(--line);
    border-radius: 19px;
    background: linear-gradient(145deg, #172239, #0e1627);
    box-shadow: 0 18px 50px #00000030;
}

.panel-top {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 3px 3px 12px;
    color: #a6b7ce;
    font-size: 10px;
    font-weight: bold;
    letter-spacing: 2px;
}

.status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 10px var(--green);
}

.live-label {
    margin-left: auto;
    color: var(--green);
}

.game-screen {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    border: 1px solid #2a4b4a;
    border-radius: 12px;
    background: #080e19;
}

#game-canvas {
    display: block;
    width: 100%;
    height: 100%;
}

.game-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 16px;
    background: #080e19dc;
    backdrop-filter: blur(5px);
}

.game-overlay.hidden {
    display: none;
}

.start-card {
    width: 100%;
    text-align: center;
}

.start-icon {
    margin-bottom: 14px;
    font-size: 48px;
    filter: drop-shadow(0 0 15px #5cff9d50);
}

.start-card h2 {
    font-size: clamp(20px, 5vw, 27px);
}

.start-card p {
    margin-top: 10px;
    color: #a3b2c8;
    font-size: 12px;
    line-height: 1.6;
}

#start-button {
    margin-top: 23px;
    padding: 14px 23px;
    border: 1px solid #9affbd;
    border-radius: 11px;
    background: linear-gradient(135deg, #77ffad, #39d77c);
    color: #092016;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 1px;
    box-shadow: 0 6px 24px #3ce88725;
    cursor: pointer;
}

#start-button:active {
    transform: scale(0.96);
}

.controller-panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    padding: 22px 16px;
    border: 1px solid var(--line);
    border-radius: 19px;
    background: linear-gradient(145deg, #172239, #0e1627);
}

.controller-heading {
    margin-bottom: 22px;
    text-align: center;
}

.controller-heading h2 {
    font-size: 19px;
}

.controller-heading p {
    margin-top: 6px;
    color: var(--muted);
    font-size: 11px;
}

.dpad {
    display: grid;
    grid-template-columns: repeat(3, 72px);
    grid-template-rows: repeat(3, 66px);
    gap: 0;
    padding: 8px;
    border: 1px solid #4b5669;
    border-radius: 28px;
    background: linear-gradient(145deg, #353b47, #181e29 65%);
    box-shadow:
        0 15px 25px #00000055,
        inset 0 2px 3px #ffffff24,
        inset 0 -4px 8px #00000055;
}

.direction {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    min-height: 0;
    border: 1px solid #666e7c;
    background: linear-gradient(145deg, #303642, #161b24);
    color: #b6c3d5;
    font-size: 22px;
    cursor: pointer;
    touch-action: manipulation;
    user-select: none;
    transition:
        background 0.08s,
        color 0.08s,
        transform 0.08s;
    box-shadow:
        inset 0 2px 3px #ffffff0c,
        inset 0 -3px 5px #00000055;
}

.direction span {
    filter: drop-shadow(0 1px 1px #000);
}

.direction.up {
    grid-column: 2;
    grid-row: 1;
    border-radius: 12px 12px 3px 3px;
    border-bottom-color: #202631;
}

.direction.left {
    grid-column: 1;
    grid-row: 2;
    border-radius: 12px 3px 3px 12px;
    border-right-color: #202631;
}

.direction.right {
    grid-column: 3;
    grid-row: 2;
    border-radius: 3px 12px 12px 3px;
    border-left-color: #202631;
}

.direction.down {
    grid-column: 2;
    grid-row: 3;
    border-radius: 3px 3px 12px 12px;
    border-top-color: #202631;
}

.dpad-center {
    grid-column: 2;
    grid-row: 2;
    display: grid;
    place-items: center;
    border: 1px solid #5b6371;
    background: linear-gradient(145deg, #202530, #111620);
    box-shadow: inset 0 3px 7px #00000070;
}

.center-ring {
    display: grid;
    place-items: center;
    width: 43px;
    height: 43px;
    border: 2px solid #555e6b;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 25%, #424956, #1a1e27 75%);
    color: #8b96a7;
    font-size: 17px;
    box-shadow:
        0 3px 5px #00000070,
        inset 0 1px 2px #ffffff20;
}

.direction:active {
    z-index: 2;
    transform: scale(0.94);
    border-color: #9affbd;
    background: linear-gradient(145deg, #55e991, #209c5a);
    color: #07170e;
    box-shadow: 0 0 18px #5cff9d45;
}

.direction:focus-visible,
#start-button:focus-visible {
    outline: 2px solid white;
    outline-offset: 3px;
}

.control-hint {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 24px;
    color: var(--muted);
    font-size: 9px;
    letter-spacing: 1px;
}

.hint-key {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border: 1px solid #35445b;
    border-radius: 5px;
    background: #1b273b;
    color: #b9c9dc;
    font-size: 10px;
}

.control-hint > span:last-child {
    margin-left: 5px;
}

.game-footer {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-top: 22px;
    color: #657790;
    font-size: 9px;
    letter-spacing: 1.2px;
}

.game-footer span:first-child {
    color: var(--green);
}

@media (orientation: landscape) and (min-width: 500px) {
    body {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 12px 22px;
    }

    .game-container {
        max-width: 950px;
    }

    .game-header {
        margin-bottom: 14px;
    }

    .brand-icon {
        width: 40px;
        height: 40px;
        font-size: 23px;
    }

    .brand h1 {
        font-size: 21px;
    }

    .game-layout {
        flex-direction: row;
        justify-content: center;
        align-items: center;
        gap: clamp(18px, 4vw, 50px);
    }

    .game-panel {
        flex: 1 1 0;
        width: auto;
        max-width: min(480px, calc(100dvh - 155px));
    }

    .controller-panel {
        flex: 0 0 255px;
        width: 255px;
        padding: 22px 10px;
    }

    .controller-heading {
        margin-bottom: 18px;
    }

    .dpad {
        grid-template-columns: repeat(3, 62px);
        grid-template-rows: repeat(3, 58px);
    }

    .center-ring {
        width: 37px;
        height: 37px;
    }

    .game-footer {
        margin-top: 13px;
    }
}

@media (orientation: landscape) and (max-height: 500px) {
    body {
        padding: 8px 14px;
    }

    .game-header {
        margin-bottom: 8px;
    }

    .brand-icon {
        width: 32px;
        height: 32px;
        font-size: 19px;
    }

    .brand h1 {
        font-size: 17px;
    }

    .brand p {
        font-size: 7px;
    }

    .score-card {
        min-width: 65px;
        padding: 6px 9px;
    }

    .score-card strong {
        font-size: 17px;
    }

    .game-layout {
        gap: 18px;
    }

    .game-panel {
        max-width: calc(100dvh - 90px);
        padding: 7px;
    }

    .panel-top {
        padding-bottom: 6px;
        font-size: 8px;
    }

    .controller-panel {
        flex-basis: 220px;
        width: 220px;
        padding: 9px 5px;
    }

    .controller-heading {
        margin-bottom: 8px;
    }

    .controller-heading h2 {
        font-size: 15px;
    }

    .controller-heading p {
        margin-top: 3px;
        font-size: 9px;
    }

    .dpad {
        grid-template-columns: repeat(3, 54px);
        grid-template-rows: repeat(3, 45px);
        padding: 6px;
        border-radius: 19px;
    }

    .direction {
        font-size: 18px;
    }

    .center-ring {
        width: 29px;
        height: 29px;
        font-size: 13px;
    }

    .control-hint {
        margin-top: 10px;
    }

    .game-footer {
        margin-top: 8px;
        font-size: 8px;
    }
}

@media (max-width: 380px) and (orientation: portrait) {
    body {
        padding: 14px;
    }

    .game-header {
        gap: 8px;
        margin-bottom: 16px;
    }

    .brand {
        gap: 8px;
    }

    .brand-icon {
        width: 39px;
        height: 39px;
        font-size: 22px;
    }

    .brand h1 {
        font-size: 20px;
    }

    .score-board {
        gap: 6px;
    }

    .score-card {
        min-width: 62px;
        padding: 8px;
    }

    .score-card strong {
        font-size: 18px;
    }

    .game-layout {
        gap: 18px;
    }

    .dpad {
        grid-template-columns: repeat(3, 64px);
        grid-template-rows: repeat(3, 58px);
    }

    .direction {
        font-size: 20px;
    }

    .game-footer {
        font-size: 8px;
    }
}
